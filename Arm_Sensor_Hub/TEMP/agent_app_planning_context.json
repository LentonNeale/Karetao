{
  "$schema": "urn:arm-sensor-hub:app-planning-context:v1",
  "meta": {
    "schema_version": "1.0.0",
    "project_id": "arm_sensor_hub_f405",
    "date_utc": "2026-09-05",
    "purpose": "Firmware for STM32F405 sensor hub with SPI slave uplink, CAN bus, I2C sensor bus, and FreeRTOS runtime.",
    "planning_scope": "app-level software only",
    "machine_optimized": true
  },
  "system": {
    "mcu": {
      "part": "STM32F405RGT6",
      "core": "Cortex-M4F"
    },
    "clock": {
      "sysclk_hz": 168000000,
      "source": "PLL from HSE",
      "hse_hz": 8000000
    },
    "rtos": {
      "kernel": "FreeRTOS",
      "api": "CMSIS-RTOS2",
      "tick_hz": 1000,
      "heap_scheme": "heap_4",
      "total_heap_bytes": 15360,
      "max_priorities": 56,
      "preemptive": true
    },
    "irq_constraints": {
      "configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY": 5,
      "rule": "Only ISRs at or below syscall-safe priority may call FreeRTOS FromISR APIs; numerically lower priority ISRs must not."
    }
  },
  "interfaces": {
    "i2c1": {
      "pins": {
        "scl": "PB6",
        "sda": "PB7"
      },
      "mode": "master",
      "speed_hz": 400000
    },
    "can1": {
      "pins": {
        "rx": "PB8",
        "tx": "PB9"
      },
      "mode": "normal",
      "timing": {
        "prescaler": 16,
        "bs1_tq": 1,
        "bs2_tq": 1,
        "sjw_tq": 1
      },
      "auto_retransmission": false
    },
    "spi3": {
      "pins": {
        "nss": "PA15",
        "sck": "PC10",
        "miso": "PC11",
        "mosi": "PC12"
      },
      "mode": "slave",
      "frame_bits": 8,
      "nss": "hardware input",
      "dma": {
        "rx_stream": "DMA1_Stream0",
        "tx_stream": "DMA1_Stream5"
      }
    },
    "gpio": {
      "data_ready": {
        "pin": "PA8",
        "mode": "output_push_pull",
        "default_level": "low"
      }
    }
  },
  "software_architecture": {
    "layers": [
      "generated_platform_layer (CubeMX/HAL/RTOS startup + peripheral init)",
      "app_layer (App/Inc + App/Src business logic)"
    ],
    "regen_policy": [
      "CubeMX files are regenerable.",
      "Custom edits in generated files must remain inside USER CODE blocks.",
      "App layer files are non-generated and safe for direct implementation."
    ],
    "entry_sequence": [
      "HAL_Init",
      "SystemClock_Config",
      "MX_GPIO_Init",
      "MX_DMA_Init",
      "MX_I2C1_Init",
      "MX_SPI3_Init",
      "MX_CAN1_Init",
      "MX_TIM2_Init",
      "App_Init",
      "osKernelInitialize",
      "defaultTask creation",
      "osKernelStart"
    ]
  },
  "app_layer_status": {
    "module_registry": [
      "app_init",
      "sensor_task",
      "can_service",
      "spi_slave_service",
      "health_monitor"
    ],
    "implemented_functions": [
      "App_Init",
      "App_Start",
      "SensorTask_Init",
      "SensorTask_Process",
      "CanService_Init",
      "CanService_Process",
      "SpiSlaveService_Init",
      "SpiSlaveService_Process",
      "HealthMonitor_Init",
      "HealthMonitor_Process"
    ],
    "current_state": "Compile-safe skeleton only; module internals not implemented."
  },
  "build_system": {
    "build_tool": "CMake",
    "toolchain": "arm-none-eabi-gcc",
    "language_standard": "C11",
    "presets": ["Debug", "Release"],
    "app_sources_registered": true
  },
  "planning_directives": {
    "primary_goal": "Implement reliable app-level dataflow: I2C sensor acquisition -> processing -> CAN and SPI publication.",
    "constraints": [
      "Keep generated layer thin; implement logic in App/*.",
      "Avoid long blocking operations in runtime-critical paths.",
      "Keep ISRs minimal; defer work to tasks via queue/notify/event.",
      "Define explicit ownership for shared data buffers.",
      "Design for recoverable bus faults and timeout handling."
    ],
    "recommended_first_tasks": [
      "Define canonical data model (sensor frame, status frame, command frame).",
      "Define module contracts in headers before internals.",
      "Create RTOS task topology and IPC objects.",
      "Implement SPI slave DMA transaction state machine.",
      "Implement CAN command RX + telemetry TX schedule.",
      "Implement health monitoring + heartbeat/fault reporting."
    ]
  },
  "known_gaps": [
    "No app-level task creation beyond default scaffold.",
    "SPI/CAN protocol payload schema not yet defined.",
    "No fault-recovery policy for transport errors/timeouts.",
    "CAN timing/network profile not validated for deployment bus.",
    "No watchdog policy integrated."
  ],
  "source_anchors": [
    {
      "path": "README.md",
      "role": "hardware and interface overview"
    },
    {
      "path": "Core/Src/main.c",
      "role": "boot flow, peripheral init, App_Init call site"
    },
    {
      "path": "Core/Src/freertos.c",
      "role": "FreeRTOS user insertion points"
    },
    {
      "path": "Core/Inc/FreeRTOSConfig.h",
      "role": "kernel and interrupt-priority constraints"
    },
    {
      "path": "CMakeLists.txt",
      "role": "app source registration and include wiring"
    },
    {
      "path": "App/Src/app_init.c",
      "role": "app module initialization fan-out"
    },
    {
      "path": "App/Src/spi_slave_service.c",
      "role": "SPI service implementation target"
    }
  ]
}
